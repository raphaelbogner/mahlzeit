### Mahlzeit Workspace API — examples for the VS Code REST Client.
### Phase 1: sessions + items (freitext only).
###
### Setup:
###   1. Run server/schema.sql against your local MySQL.
###   2. Run `php server/seed.php --create-test-workspace "Dev"` to create
###      a workspace and print its token.
###   3. Replace the @token / @userId values below with real ones.

@host = http://localhost:8000
@token = REPLACE_WITH_WORKSPACE_TOKEN
@userId = u1234567890abcde
@userName = Test User
@sessionId = REPLACE_AFTER_CREATE
@itemId = REPLACE_AFTER_ADD

### --- sessions ---------------------------------------------------------

### List sessions
GET {{host}}/api/sessions
X-Workspace-Token: {{token}}

### List sessions via query-param token
GET {{host}}/api/sessions?w={{token}}

### Create a session
POST {{host}}/api/sessions
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "user_name": "{{userName}}",
  "title": "Pizza-Donnerstag",
  "restaurant_name": "Pizzeria Roma",
  "deadline": "2026-05-08 11:30",
  "creator_iban": "AT611904300234573201"
}

### Get a single session (with items)
GET {{host}}/api/sessions/{{sessionId}}
X-Workspace-Token: {{token}}

### Patch a session (creator only). Any subset of fields is allowed.
PATCH {{host}}/api/sessions/{{sessionId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "title": "Pizza-Donnerstag (verschoben)",
  "deadline": "2026-05-08 12:00"
}

### Close a session (creator only)
PATCH {{host}}/api/sessions/{{sessionId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "status": "closed"
}

### Reopen a session (creator only)
PATCH {{host}}/api/sessions/{{sessionId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "status": "open"
}

### Delete a session (creator only)
DELETE {{host}}/api/sessions/{{sessionId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}"
}

### --- items (freitext) -------------------------------------------------

### Add a freitext item with price (in cents — 11.50 EUR = 1150)
POST {{host}}/api/sessions/{{sessionId}}/items
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "user_name": "{{userName}}",
  "dish": "Margherita Mittel",
  "note": "ohne Knoblauch",
  "price_cents": 1150
}

### Add a freitext item without price
POST {{host}}/api/sessions/{{sessionId}}/items
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "user_name": "{{userName}}",
  "dish": "Cola 0,5l"
}

### Update own item
PATCH {{host}}/api/sessions/{{sessionId}}/items/{{itemId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "dish": "Margherita Groß",
  "price_cents": 1350
}

### Delete own item
DELETE {{host}}/api/sessions/{{sessionId}}/items/{{itemId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}"
}

### --- restaurants ----------------------------------------------------

@restaurantId = REPLACE_AFTER_RESTAURANT_CREATE

### List restaurants
GET {{host}}/api/restaurants
X-Workspace-Token: {{token}}

### Create a restaurant
POST {{host}}/api/restaurants
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "name": "Pizzeria Roma"
}

### Get a restaurant with full menu
GET {{host}}/api/restaurants/{{restaurantId}}
X-Workspace-Token: {{token}}

### Rename a restaurant
PATCH {{host}}/api/restaurants/{{restaurantId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "name": "Pizzeria Roma (neu)"
}

### Replace the entire menu (transactional bulk PUT)
PUT {{host}}/api/restaurants/{{restaurantId}}/menu
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "dishes": [
    {
      "name": "Margherita",
      "category": "Pizza",
      "description": "Tomaten, Käse, Oregano, Sauce",
      "base_price_cents": 950,
      "is_vegetarian": true,
      "option_groups": [
        {
          "name": "Größe",
          "selection_type": "single",
          "options": [
            {"name": "Klein",  "price_delta_cents": 0},
            {"name": "Mittel", "price_delta_cents": 150},
            {"name": "Groß",   "price_delta_cents": 300}
          ]
        },
        {
          "name": "Toppings",
          "selection_type": "multi",
          "options": [
            {"name": "extra Käse", "price_delta_cents": 100},
            {"name": "Salami",     "price_delta_cents": 150}
          ]
        }
      ]
    },
    {
      "name": "Cola 0,5l",
      "base_price_cents": 350,
      "option_groups": []
    }
  ]
}

### Delete a restaurant (cascade-deletes its menu; items keep snapshot)
DELETE {{host}}/api/restaurants/{{restaurantId}}
X-Workspace-Token: {{token}}

### --- structured items -----------------------------------------------

@dishId = REPLACE_FROM_RESTAURANT_DETAIL
@optionSizeId = REPLACE_FROM_RESTAURANT_DETAIL
@optionToppingId = REPLACE_FROM_RESTAURANT_DETAIL

### Create a session linked to a restaurant
POST {{host}}/api/sessions
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "user_name": "{{userName}}",
  "title": "Pizza-Donnerstag",
  "restaurant_id": "{{restaurantId}}"
}

### Add a structured item (server computes price + snapshots options)
POST {{host}}/api/sessions/{{sessionId}}/items
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "user_name": "{{userName}}",
  "dish_id": "{{dishId}}",
  "option_ids": ["{{optionSizeId}}", "{{optionToppingId}}"],
  "note": "ohne Knoblauch"
}

### --- error cases (for sanity-checking) -------------------------------

### Missing token → 401
GET {{host}}/api/sessions

### Wrong token → 401
GET {{host}}/api/sessions
X-Workspace-Token: not-a-real-token

### Unknown field → 400
POST {{host}}/api/sessions
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "user_name": "{{userName}}",
  "title": "Test",
  "evil_field": "should be rejected"
}

### Invalid IBAN → 400
POST {{host}}/api/sessions
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "user_name": "{{userName}}",
  "title": "Test",
  "creator_iban": "AT00WRONG"
}

### --- admin api -------------------------------------------------------
### Cookie-based session auth + double-submit CSRF.
### After running `php server/seed.php <admin-user> <password>` once, log in.
### The REST Client follows Set-Cookie automatically across requests in the
### same file, so subsequent calls carry the admin session cookie.

@adminUser = admin
@adminPass = REPLACE_WITH_ADMIN_PASSWORD
@csrf = REPLACE_AFTER_LOGIN
@workspaceId = 1

### Login → returns {admin, csrf_token}. Copy csrf_token into @csrf above.
POST {{host}}/admin/api/login
Content-Type: application/json

{
  "username": "{{adminUser}}",
  "password": "{{adminPass}}"
}

### Who am I (also refreshes the CSRF token if one exists).
GET {{host}}/admin/api/me

### List workspaces with stats
GET {{host}}/admin/api/workspaces

### Create a workspace (returns full detail incl. token + share URL)
POST {{host}}/admin/api/workspaces
Content-Type: application/json
X-CSRF-Token: {{csrf}}

{
  "name": "Acme GmbH"
}

### Workspace detail (stats + active_users)
GET {{host}}/admin/api/workspaces/{{workspaceId}}

### Rename a workspace
PATCH {{host}}/admin/api/workspaces/{{workspaceId}}
Content-Type: application/json
X-CSRF-Token: {{csrf}}

{
  "name": "Acme (renamed)"
}

### Rotate the workspace token (old token stops working immediately)
POST {{host}}/admin/api/workspaces/{{workspaceId}}/rotate
X-CSRF-Token: {{csrf}}

### Delete a workspace (cascades through sessions/items/restaurants)
DELETE {{host}}/admin/api/workspaces/{{workspaceId}}
X-CSRF-Token: {{csrf}}

### Logout
POST {{host}}/admin/api/logout
X-CSRF-Token: {{csrf}}

### Missing CSRF on a write → 403
POST {{host}}/admin/api/workspaces
Content-Type: application/json

{
  "name": "Should fail"
}

### Wrong password → 401 (and contributes to rate-limit bucket)
POST {{host}}/admin/api/login
Content-Type: application/json

{
  "username": "{{adminUser}}",
  "password": "definitely-wrong"
}

### --- option group templates -----------------------------------------

### List templates (workspace-scoped)
GET {{host}}/api/option-templates
X-Workspace-Token: {{token}}

### Create a template
POST {{host}}/api/option-templates
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "name": "Größe",
  "selection_type": "single",
  "options": [
    { "name": "Klein",  "price_delta_cents": 0 },
    { "name": "Mittel", "price_delta_cents": 150 },
    { "name": "Groß",   "price_delta_cents": 300 }
  ]
}

### Delete a template
DELETE {{host}}/api/option-templates/REPLACE_TEMPLATE_ID
X-Workspace-Token: {{token}}

### --- payment marking ------------------------------------------------

### Mark another user as the payer (creator only). Sends snapshot of name.
PATCH {{host}}/api/sessions/{{sessionId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "paid_by_user_id": "REPLACE_PAYER_USER_ID",
  "paid_by_user_name": "Anna Müller"
}

### Marked payer fills in their own IBAN later
PATCH {{host}}/api/sessions/{{sessionId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "REPLACE_PAYER_USER_ID",
  "paid_by_iban": "AT611904300234573201"
}

### Clear the payer override (back to "creator paid" default)
PATCH {{host}}/api/sessions/{{sessionId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "paid_by_user_id": null
}

### Effective payer marks an item as paid (works on closed sessions too)
PATCH {{host}}/api/sessions/{{sessionId}}/items/{{itemId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "paid": true
}

### =====================================================================
### Phase 1 – quantity (migration 006)
### =====================================================================

### Freitext item with quantity (unit price 2,50 € → line total 7,50 €)
POST {{host}}/api/sessions/{{sessionId}}/items
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "user_name": "Anna",
  "dish": "Cola",
  "price_cents": 250,
  "quantity": 3
}

### Structured item with quantity
POST {{host}}/api/sessions/{{sessionId}}/items
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "user_name": "Anna",
  "dish_id": "{{dishId}}",
  "option_ids": [],
  "quantity": 2
}

### Change quantity (owner, session open; works for structured items too)
PATCH {{host}}/api/sessions/{{sessionId}}/items/{{itemId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "quantity": 4
}

### Invalid quantity → 400 INVALID_FIELD
PATCH {{host}}/api/sessions/{{sessionId}}/items/{{itemId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "quantity": 21
}

### =====================================================================
### Phase 1 – deadline_at + auto close (migration 007)
### =====================================================================

### Create a session with a deadline (ISO-8601, any offset; stored as UTC)
POST {{host}}/api/sessions
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "user_name": "Anna",
  "title": "Pizza Freitag",
  "deadline_at": "2026-09-08T11:30:00+02:00"
}

### Deadline in the past → 400 INVALID_FIELD
POST {{host}}/api/sessions
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "user_name": "Anna",
  "title": "Zu spät",
  "deadline_at": "2020-01-01T10:00:00Z"
}

### Creator changes the deadline (open session only makes sense)
PATCH {{host}}/api/sessions/{{sessionId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "deadline_at": "2026-09-08T12:00:00+02:00"
}

### Remove the deadline
PATCH {{host}}/api/sessions/{{sessionId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "deadline_at": null
}

### Reopen after auto-close: clears deadline_at and auto_closed
PATCH {{host}}/api/sessions/{{sessionId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "status": "open"
}

### Any GET closes overdue sessions first; check auto_closed / closed_at
GET {{host}}/api/sessions/{{sessionId}}
X-Workspace-Token: {{token}}

### =====================================================================
### Phase 1 – "order again" suggestions (read-only)
### =====================================================================

### Last 3 distinct orders of this user at the session's restaurant
### (empty list when the session has no linked restaurant)
GET {{host}}/api/sessions/{{sessionId}}/suggestions?user_id={{userId}}
X-Workspace-Token: {{token}}

### Missing/invalid user_id → 400 INVALID_FIELD
GET {{host}}/api/sessions/{{sessionId}}/suggestions
X-Workspace-Token: {{token}}

### =====================================================================
### Phase 2 – archive (migration 008)
### =====================================================================

### Archive a closed session (creator or effective payer)
PATCH {{host}}/api/sessions/{{sessionId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "archived": true
}

### Restore from archive
PATCH {{host}}/api/sessions/{{sessionId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "archived": false
}

### Archiving an open session → 409 SESSION_OPEN
### Any GET also runs housekeeping: 30-day-old open sessions get closed,
### sessions closed 30+ days ago with nothing left to pay get archived.
GET {{host}}/api/sessions
X-Workspace-Token: {{token}}

### =====================================================================
### Phase 2 – payment status (migration 009)
### =====================================================================

### List with per-person totals for the due overview
GET {{host}}/api/sessions?user_id={{userId}}
X-Workspace-Token: {{token}}

### Orderer: "I transferred" for one item (closed session, not yet paid)
PATCH {{host}}/api/sessions/{{sessionId}}/items/{{itemId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "reported": true
}

### Orderer: report all own unpaid items at once (reported=false takes it back)
POST {{host}}/api/sessions/{{sessionId}}/items/report
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "reported": true
}

### Payer: confirm every item of one person as paid (paid=false resets, also clears "reported")
POST {{host}}/api/sessions/{{sessionId}}/items/mark-paid
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{payerUserId}}",
  "target_user_id": "{{userId}}",
  "paid": true
}

### =====================================================================
### Phase 2 – participation (migration 010)
### =====================================================================

### Who is known (ordered in the last 60 days), who ordered here, who declined
### (creator or effective payer only → otherwise 403)
GET {{host}}/api/sessions/{{sessionId}}/participation?user_id={{userId}}
X-Workspace-Token: {{token}}

### "Heute nicht dabei" (open session only)
PUT {{host}}/api/sessions/{{sessionId}}/decline
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "user_name": "Anna"
}

### Take the decline back
DELETE {{host}}/api/sessions/{{sessionId}}/decline
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}"
}

### Session GET with my_declined flag
GET {{host}}/api/sessions/{{sessionId}}?user_id={{userId}}
X-Workspace-Token: {{token}}

### =====================================================================
### Phase 3 – push (migration 011, see docs/PUSH_SETUP.md)
### =====================================================================

### Is push configured? (enabled=false until config.php has a push section)
GET {{host}}/api/push/config
X-Workspace-Token: {{token}}

### Register this device (payload as produced by PushSubscription.toJSON())
PUT {{host}}/api/push/subscription
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "endpoint": "https://fcm.googleapis.com/fcm/send/example",
  "keys": { "p256dh": "BExample…", "auth": "authExample" },
  "user_agent": "manual test"
}

### Unregister
DELETE {{host}}/api/push/subscription
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "endpoint": "https://fcm.googleapis.com/fcm/send/example"
}

### Queue + deliver a test notification to my own devices
POST {{host}}/api/push/test
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}"
}

### =====================================================================
### Phase 4 – favorites (migration 012) and stats
### =====================================================================

### My favorites at one restaurant
GET {{host}}/api/favorites?user_id={{userId}}&restaurant_id={{restaurantId}}
X-Workspace-Token: {{token}}

### Mark a dish as favorite
PUT {{host}}/api/favorites/{{dishId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}"
}

### Remove favorite
DELETE {{host}}/api/favorites/{{dishId}}
X-Workspace-Token: {{token}}
Content-Type: application/json

{
  "user_id": "{{userId}}"
}

### Workspace statistics (range=30d|year|all); user_id adds "my top dishes"
GET {{host}}/api/stats?range=30d&user_id={{userId}}
X-Workspace-Token: {{token}}
